# Copy to .env and edit:  cp .env.example .env  &&  docker compose up -d --build
# See the README: "Deploying a controller and workers".

# What runs on THIS machine:
#   controller          the machine running Plex: the TUI, queueing and importing (no media needed)
#   worker              next to the media / where the CPU is (a NAS is ideal; any number of machines)
#   controller,worker   one machine doing both
COMPOSE_PROFILES=controller,worker

# Required: the shared folder, as a path on THIS machine. The controller and every worker must
# reach the SAME folder: e.g. /mnt/user/plex-loudness on the NAS itself, and that share mounted
# at /mnt/nas/plex-loudness on the Plex host. Batches, results and status live here.
WORK_PATH=/mnt/share/plex-loudness

# Worker: your media root on THIS machine, mounted read-only at /media. Plex's own folders
# (/tv, /movies, ...) are found under it automatically (or set PATH_MAP below).
# (Not needed on a controller-only machine.)
MEDIA_PATH=/mnt/media

# User/group the containers run as: must be able to read the media and write WORK_PATH (id -u / id -g)
PUID=1000
PGID=1000

# Worker: its name in the TUI (use the machine's name), parallel tracks (0 = CPUs - 2), CPU and memory caps.
# Keep WORKERS at or below the cores that are actually free: past that every track just runs slower.
WORKER_NAME=nas
WORKERS=0
CPUS=8
#MEM_LIMIT=6g

TZ=Etc/UTC

# Optional overrides (normally auto-detected / sensible defaults):
#PLEX_CONTAINER=plex
#PLEX_USER=abc
#PATH_MAP=/tv=/media/tv_shows,/movies=/media/movies
#STALL_SECONDS=900        # kill a track whose ffmpeg makes no progress for this long
#TIMEOUT_FACTOR=4         # hard limit per track = duration x factor + 30 min
