# Copy to .env and edit:  cp .env.example .env  &&  docker compose up -d --build

# What this container does:
#   controller  on the machine running Plex: the TUI, queueing and importing (no media needed)
#   worker      next to the media (a NAS is ideal): measures the queued audio tracks
#   both        a single machine doing everything
ROLE=both

# Required: the shared folder. Controller and workers must all point at the SAME folder
# (e.g. a NAS share mounted on the Plex host). Batches, results and status live here.
WORK_PATH=/mnt/share/plex-loudness

# Controller / both: give it the docker socket so it can reach the Plex container.
COMPOSE_FILE=docker-compose.yml:docker-compose.controller.yml

# Worker / both: the media root, mounted read-only at /media. Plex's own folders
# (/tv, /movies, ...) are found under it automatically.
MEDIA_PATH=/mnt/media

# Worker: user/group that can read the media and write WORK_PATH (id -u / id -g)
PUID=1000
PGID=1000

# Worker: parallel tracks (0 = CPUs - 2), CPU and memory caps, and its name in the TUI
WORKERS=0
CPUS=8
#MEM_LIMIT=6g
WORKER_NAME=plex-loudness

TZ=Etc/UTC

# Optional overrides (normally auto-detected):
#PLEX_CONTAINER=plex
#PLEX_USER=abc
#PATH_MAP=/tv=/media/tv_shows,/movies=/media/movies
